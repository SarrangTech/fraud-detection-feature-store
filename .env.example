# Copy this file to .env and fill in real values. Never commit the real .env file.

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=fraud.transactions.raw
KAFKA_PRODUCER_CLIENT_ID=creditcard-producer
KAFKA_CONSUMER_GROUP_ID=fraud-bronze-consumer
# Rows/sec the producer simulates (1 = one row per second, 0 = no throttling / max speed)
PRODUCER_EVENTS_PER_SECOND=20

# ── Dataset ──────────────────────────────────────────────────────────────────
RAW_DATA_PATH=data/raw/creditcard.csv
# Number of simulated user accounts the anonymized dataset's rows are hashed into
# (see docs/architecture.md — the source dataset has no real customer identifier)
SIMULATED_USER_POOL_SIZE=5000

# ── Databricks workspace ─────────────────────────────────────────────────────
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_CLUSTER_ID=<cluster-id-for-job-runs>

# Unity Catalog 3-level namespace used throughout bronze/silver/feature store/model registry
UC_CATALOG=fraud_detection
UC_SCHEMA=feature_store
UC_MODEL_NAME=fraud_detection.feature_store.fraud_gbm_classifier

# Delta table names (fully qualified, derived from UC_CATALOG/UC_SCHEMA above)
BRONZE_TABLE=fraud_detection.feature_store.bronze_transactions
SILVER_TABLE=fraud_detection.feature_store.silver_transaction_features
FEATURE_TABLE=fraud_detection.feature_store.user_fraud_features

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
MLFLOW_EXPERIMENT_NAME=/Shared/fraud-detection-feature-store
MODEL_SERVING_ENDPOINT_NAME=fraud-gbm-realtime

# ── Redis (online feature store) ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_FEATURE_KEY_PREFIX=user_features
REDIS_FEATURE_TTL_SECONDS=86400

# ── Scoring service ──────────────────────────────────────────────────────────
SCORING_API_HOST=0.0.0.0
SCORING_API_PORT=8080
FRAUD_DECISION_THRESHOLD=0.30
SCORING_LATENCY_BUDGET_MS=100
